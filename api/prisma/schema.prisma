generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/Mac/Linux glibc); the musl target is
  // needed because the api Docker image runs on node:alpine (musl libc) —
  // without it Prisma tries to download the missing engine at container
  // startup and fails in an offline/restricted container network.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered user. Owns recipes.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")

  recipes Recipe[]

  @@map("users")
}

/// Base unit of measure. Dataset only ever uses g / ml / piece,
/// each already the base unit for its dimension, so no conversion
/// factor is needed — the unit code itself is the base.
model Unit {
  code      String @id
  dimension String // 'mass' | 'volume' | 'count'

  ingredients        Ingredient[]
  recipeComponents   RecipeComponent[]

  @@map("units")
}

/// Global, deduplicated catalogue of raw ingredients.
model Ingredient {
  id              String  @id @default(uuid())
  name            String  @unique
  defaultUnitCode String  @map("default_unit_code")
  defaultUnit     Unit    @relation(fields: [defaultUnitCode], references: [code])
  category        String?
  isVegan         Boolean? @map("is_vegan")
  isVegetarian    Boolean? @map("is_vegetarian")
  costPerUnit     Decimal? @map("cost_per_unit") @db.Decimal(10, 4)
  kcalPerUnit     Decimal? @map("kcal_per_unit") @db.Decimal(10, 4)

  components RecipeComponent[]

  @@map("ingredients")
}

/// A recipe: either composed entirely of raw ingredients, or reusing
/// other recipes as components (recipe_components), or both.
model Recipe {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  servings    Int
  prepMin     Int?     @map("prep_min")
  cookMin     Int?     @map("cook_min")
  difficulty  String?  // 'easy' | 'medium' | 'hard'
  category    String?
  dietType    String?  @map("diet_type") // 'vegetarian' | 'non-vegetarian' | 'vegan'
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // components that make up THIS recipe (its children)
  components RecipeComponent[] @relation("ParentRecipe")
  // other recipes that use THIS recipe as a component (its parents / dependents)
  usedIn     RecipeComponent[] @relation("ChildRecipe")

  @@unique([ownerId, name])
  @@map("recipes")
}

/// One edge in the recipe DAG: a single component (ingredient or
/// sub-recipe) belonging to a parent recipe.
model RecipeComponent {
  id       String @id @default(uuid())

  parentId String @map("parent_id")
  parent   Recipe @relation("ParentRecipe", fields: [parentId], references: [id], onDelete: Cascade)

  kind String // 'ingredient' | 'recipe'

  ingredientId String?     @map("ingredient_id")
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  childRecipeId String? @map("child_recipe_id")
  childRecipe   Recipe? @relation("ChildRecipe", fields: [childRecipeId], references: [id], onDelete: Restrict)

  quantity Decimal @db.Decimal(12, 4)

  unitCode String? @map("unit_code")
  unit     Unit?   @relation(fields: [unitCode], references: [code])

  position Int     @default(0)
  note     String?

  @@index([parentId])
  @@index([childRecipeId])
  @@map("recipe_components")
}
