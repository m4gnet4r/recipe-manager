# --- Postgres ---
POSTGRES_USER=recipes
POSTGRES_PASSWORD=recipes_dev_password
POSTGRES_DB=recipes
POSTGRES_PORT=5433

# Used by the api container (compose injects the host automatically)
DATABASE_URL=postgresql://recipes:recipes_dev_password@db:5432/recipes?schema=public

# --- API ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
